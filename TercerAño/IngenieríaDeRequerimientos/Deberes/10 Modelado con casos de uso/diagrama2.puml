@startuml diagram2
left to right direction
skinparam packageStyle rectangle

actor Estudiante

rectangle "BiblioTech" {
  usecase "Pedir prestado un libro" as UC_Prestar
  usecase "Revisar disponibilidad en estantes" as UC_Disponibilidad
